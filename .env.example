# ==============================================================
# EduAdapt AI - Environment Variables Configuration
# Multimodal AI Hackathon 2026 (Track D: Adaptive Learning)
# ==============================================================

# Project Name & Version
PROJECT_NAME="EduAdapt AI"
VERSION="1.0.0"

# Application Security
# Generate a secure 32+ character key for JWT token hashing
SECRET_KEY="eduadapt-hackathon-2026-multimodal-secret-jwt-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration
# Default: Zero-configuration local SQLite database for instant development
DATABASE_URL="sqlite:///./eduadapt.db"
# Production PostgreSQL with pgvector:
# DATABASE_URL="postgresql://eduadapt_user:eduadapt_password@localhost:5432/eduadapt"

# AI Model Credentials (Optional)
# If GEMINI_API_KEY is not provided, EduAdapt AI operates in local offline mode
# with a deterministic, verified extractive RAG engine (zero fake inference).
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Model Names
AI_MODEL="gemini-3.8-flash"
EMBEDDING_MODEL="gemini-embedding-001"

# Bayesian Knowledge Tracing (BKT) Prior Defaults
BKT_DEFAULT_L0=0.20
BKT_DEFAULT_T=0.15
BKT_DEFAULT_G=0.25
BKT_DEFAULT_S=0.10
